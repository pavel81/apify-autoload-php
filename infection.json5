{
    "$schema": "https://infection.github.io/schema.json",

    "source": {
        "directories": [
            "src"
        ]
    },

    "logs": {
        "text": "build/infection.txt",
        "summary": "build/infection-summary.txt",
        "json": "build/infection.json"
    },

    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    },

    "mutators": {
        "@default": true,

        "ArrayItemRemoval": {
            "ignore": [
                "tests/*"
            ]
        }
    },

    "timeout": 10,

    "minMsi": 40,
    "minCoveredMsi": 80
}
